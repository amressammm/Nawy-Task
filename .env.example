# Copy to .env to override the defaults baked into docker-compose.yml.
# The app runs fine without a .env file — these are the same values compose falls back to.

POSTGRES_USER=nawy
POSTGRES_PASSWORD=nawy
POSTGRES_DB=nawy_apartments

# Host ports. Change these if something already occupies them locally.
DB_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Set to false to start with an empty database instead of the demo listings.
# Seeding only ever runs when the apartments table is empty.
SEED_ON_BOOT=true
